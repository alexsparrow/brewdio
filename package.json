{
  "name": "brewdio",
  "version": "0.7.1",
  "scripts": {
    "build:wasm": "wasm-pack build brewdio-wasm --target web --dev",
    "typecheck": "bun run --filter '*' typecheck",
    "tauri:dev": "tauri dev --config brewdio-desktop/tauri.conf.json",
    "tauri:build": "tauri build --config brewdio-desktop/tauri.conf.json"
  },
  "workspaces": [
    "brewdio-webui",
    "brewdio-wasm/pkg"
  ],
  "patchedDependencies": {
    "tinykeys@3.0.0": "patches/tinykeys@3.0.0.patch"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
